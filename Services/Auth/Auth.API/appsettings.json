{
  "LoggingOptions": {
    "ServiceName": "AuthService",
    "SeqUrl": "http://localhost:5341",
    "ElasticsearchUrl": "http://elasticsearch:9200",
    "UseConsole": true,
    "UseSeq": true,
    "UseElasticsearch": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  }
}