{
  "ReverseProxy": {
    "Routes": {
      "authRoute": {
        "ClusterId": "authCluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "userRoute": {
        "ClusterId": "authCluster",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        }
      },

      "testRoute": {
        "ClusterId": "authCluster",
        "Match": {
          "Path": "/api/v1/test/{**catch-all}"
        }
      },

      "productRoute": {
        "ClusterId": "catalogCluster",
        "Match": {
          "Path": "/api/v1/products/{**catch-all}"
        }
      },
      "categoryRoute": {
        "ClusterId": "catalogCluster",
        "Match": {
          "Path": "/api/v1/categories/{**catch-all}"
        }
      },
      "images_route": {
        "ClusterId": "catalogCluster",
        "Match": {
          "Path": "/images/{**catch-all}"
        }
      },
      "basket_route": {
        "ClusterId": "basketCluster",
        "Match": {
          "Path": "api/v1/basket/{**catch-all}"
        }
      }
    },

    "Clusters": {
      "authCluster": {
        "Destinations": {
          "auth": {
            "Address": "http://auth.api:8080/"
          }
        }
      },

      "catalogCluster": {
        "Destinations": {
          "category": {
            "Address": "http://catalog.api:8080/"
          }
        }
      },
      "basketCluster": {
        "Destinations": {
          "category": {
            "Address": "http://basket.api:8080/"
          }
        }
      }
    }
  }
}