{
  "Routes": [
    // =========================
    // Brand API
    // =========================
    {
      "DownstreamPathTemplate": "/api/v1/Brand/GetAllBrands",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "host.docker.internal",
          "Port": 8001
        }
      ],
      "UpstreamPathTemplate": "/Brand/GetAllBrands",
      "UpstreamHttpMethod": [ "GET" ]
    },

    // =========================
    // Product API
    // =========================
    {
      "DownstreamPathTemplate": "/api/v1/Product/GetProductById/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "host.docker.internal",
          "Port": 8001
        }
      ],
      "UpstreamPathTemplate": "/Product/GetProductById/{id}",
      "UpstreamHttpMethod": [ "GET" ]
    },
    {
      "DownstreamPathTemplate": "/api/v1/Product/GetProductsByName/{productName}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "host.docker.internal",
          "Port": 8001
        }
      ],
      "UpstreamPathTemplate": "/Product/GetProductsByName/{productName}",
      "UpstreamHttpMethod": [ "GET" ]
    },
    {
      "DownstreamPathTemplate": "/api/v1/Product/GetAllProducts",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "host.docker.internal",
          "Port": 8001
        }
      ],
      "UpstreamPathTemplate": "/Product/GetAllProducts",
      "UpstreamHttpMethod": [ "GET" ]
    },
    {
      "DownstreamPathTemplate": "/api/v1/Product/CreateProduct",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "host.docker.internal",
          "Port": 8001
        }
      ],
      "UpstreamPathTemplate": "/Product/CreateProduct",
      "UpstreamHttpMethod": [ "POST" ]
    },
    {
      "DownstreamPathTemplate": "/api/v1/Product/UpdateProduct",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "host.docker.internal",
          "Port": 8001
        }
      ],
      "UpstreamPathTemplate": "/Product/UpdateProduct",
      "UpstreamHttpMethod": [ "PUT" ]
    },
    {
      "DownstreamPathTemplate": "/api/v1/Product/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "host.docker.internal",
          "Port": 8001
        }
      ],
      "UpstreamPathTemplate": "/Product/{id}",
      "UpstreamHttpMethod": [ "DELETE" ]
    },

    // =========================
    // Type API
    // =========================
    {
      "DownstreamPathTemplate": "/api/v1/Type/GetAllTypes",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "host.docker.internal",
          "Port": 8001
        }
      ],
      "UpstreamPathTemplate": "/Type/GetAllTypes",
      "UpstreamHttpMethod": [ "GET" ]
    }
  ],

  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:8010"
  }
}