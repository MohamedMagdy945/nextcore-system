{
  "Routes": [
    // =========================
    // BRAND SERVICE
    // =========================
    {
      "DownstreamPathTemplate": "/api/v1/Brand/GetAllBrands",
      "UpstreamPathTemplate": "/api/v1/brand/GetAllBrands",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "host.docker.internal",
          "Port": 8001
        }
      ],
      "UpstreamHttpMethod": [ "GET" ]
    },

    // =========================
    // PRODUCT SERVICE
    // =========================
    {
      "DownstreamPathTemplate": "/api/v1/Product/GetProductById/{id}",
      "UpstreamPathTemplate": "/api/v1/product/GetProductById/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "host.docker.internal",
          "Port": 8001
        }
      ],
      "UpstreamHttpMethod": [ "GET" ]
    },
    {
      "DownstreamPathTemplate": "/api/v1/Product/GetProductsByName/{productName}",
      "UpstreamPathTemplate": "/api/v1/product/GetProductsByName/{productName}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "host.docker.internal",
          "Port": 8001
        }
      ],
      "UpstreamHttpMethod": [ "GET" ]
    },
    {
      "DownstreamPathTemplate": "/api/v1/Product/GetAllProducts",
      "UpstreamPathTemplate": "/api/v1/product/GetAllProducts",
      "DownstreamScheme": "http",
